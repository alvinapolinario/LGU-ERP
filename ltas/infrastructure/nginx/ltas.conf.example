# Staging template, not a production-approved deployment. Replace host/certificate paths.
server {
    listen 443 ssl;
    server_name ltas.example.invalid;
    ssl_certificate /etc/ltas/tls/fullchain.pem;
    ssl_certificate_key /etc/ltas/tls/privkey.pem;
    client_max_body_size 256k;
    root /srv/ltas/apps/web/dist;
    add_header X-Content-Type-Options nosniff always;
    location /api/v1/health/live {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/v1/health/ready {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/v1/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
    location /api/public/ { return 404; }
    location / { try_files $uri $uri/ /index.html; }
}
