# Generate a private local file with: node scripts/create-local-env.mjs
# Do not use these placeholders as credentials. Local synthetic environment only.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
# Keep APP_ORIGIN on loopback. Development also accepts same-port private LAN origins (10/8, 172.16/12, 192.168/16).
OIDC_ISSUER=http://localhost:8081/realms/ltas-development
OIDC_CLIENT_ID=ltas-web
OIDC_CLIENT_SECRET=GENERATE_LOCALLY
SESSION_SECRET=GENERATE_LOCALLY
DATABASE_URL=mysql://ltas_app:GENERATE_LOCALLY@127.0.0.1:3307/ltas
MIGRATION_DATABASE_URL=mysql://ltas_migrator:GENERATE_LOCALLY@127.0.0.1:3307/ltas
WORKER_DATABASE_URL=mysql://ltas_worker:GENERATE_LOCALLY@127.0.0.1:3307/ltas
REDIS_URL=redis://:GENERATE_LOCALLY@127.0.0.1:6380
AUDIT_EXPORT_DIR=../../.local/audit-exports
AUDIT_MAX_LAG_SECONDS=3600
# development only; production refuses AUDIT_ENFORCE_EXPORT_LAG=no
AUDIT_ENFORCE_EXPORT_LAG=yes
ALLOW_SYNTHETIC_SEED=yes
MYSQL_ROOT_PASSWORD=GENERATE_LOCALLY
MYSQL_APP_PASSWORD=GENERATE_LOCALLY
MYSQL_MIGRATION_PASSWORD=GENERATE_LOCALLY
MYSQL_WORKER_PASSWORD=GENERATE_LOCALLY
KEYCLOAK_DB_PASSWORD=GENERATE_LOCALLY
REDIS_PASSWORD=GENERATE_LOCALLY
KEYCLOAK_ADMIN=ltas-bootstrap
KEYCLOAK_ADMIN_PASSWORD=GENERATE_LOCALLY
MINIO_ROOT_USER=ltas-development
MINIO_ROOT_PASSWORD=GENERATE_LOCALLY
