{
  "name": "ltas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "build": "npm run build -w @ltas/contracts && npm run build -w @ltas/api && npm run build -w @ltas/web",
    "typecheck": "npm run build -w @ltas/contracts && npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @ltas/contracts && npm run test --workspaces --if-present",
    "test:mysql": "npm run test:mysql -w @ltas/api",
    "recovery": "node --env-file=.env scripts/recovery-rehearsal.mjs",
    "dev:api": "npm run dev -w @ltas/api",
    "dev:web": "npm run dev -w @ltas/web",
    "db:generate": "npm run db:generate -w @ltas/api",
    "db:migrate": "npm run db:migrate -w @ltas/api",
    "db:seed": "npm run db:seed -w @ltas/api",
    "check": "npm run db:generate && npm run typecheck && npm test && npm run build"
  },
  "overrides": {
    "mariadb": "3.5.4",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/config": "7.10.0",
    "@types/node": "^24.0.0",
    "deepmerge-ts": "8.0.2",
    "mariadb": "3.5.4",
    "mysql2": "3.24.4",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  }
}
