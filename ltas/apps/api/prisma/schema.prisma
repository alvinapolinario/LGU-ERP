generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}
datasource db {
  provider = "mysql"
}
model Municipality {
  id String @id @db.Char(36)
  code String @unique @db.VarChar(30)
  name String @db.VarChar(160)
  province String @db.VarChar(100)
  timezone String @default("Asia/Manila") @db.VarChar(50)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  users User[]
  terms CouncilTerm[]
  persons Person[]
  committees Committee[]
  auditCursor AuditCursor?
  measureTypes MeasureType[]
  measures LegislativeMeasure[]
  workflowProfiles WorkflowProfile[]
  numberSequences NumberSequence[]
  documents Document[]
  tasks WorkTask[]
  notifications InAppNotification[]
  referrals CommitteeReferral[]
  meetings CommitteeMeeting[]
  sessions LegislativeSession[]
  historicalOrdinances HistoricalOrdinance[]
  @@map("municipalities")
}
model User {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  municipality Municipality @relation(fields:[municipalityId], references:[id], onDelete:Restrict)
  issuer String @db.VarChar(255)
  subject String @db.VarChar(255)
  displayName String @db.VarChar(160)
  enabled Boolean @default(true)
  policyVersion Int @default(1)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  grants UserRole[]
  assignedTasks WorkTask[]
  notices InAppNotification[]
  @@unique([issuer,subject])
  @@unique([id,municipalityId])
  @@index([municipalityId,enabled])
  @@map("users")
}
model UserRole {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  userId String @db.Char(36)
  user User @relation(fields:[userId,municipalityId], references:[id,municipalityId], onDelete:Restrict)
  role String @db.VarChar(20)
  scopeType String @db.VarChar(20)
  scopeId String @db.Char(36)
  validFrom DateTime @db.DateTime(3)
  validUntil DateTime @db.DateTime(3)
  approvedBy String @db.Char(36)
  requestId String? @unique @db.Char(36)
  revokedAt DateTime? @db.DateTime(3)
  revision Int @default(1)
  @@index([userId,validUntil])
  @@map("user_roles")
}
model GrantRequest {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  userId String @db.Char(36)
  role String @db.VarChar(20)
  scopeType String @db.VarChar(20)
  scopeId String @db.Char(36)
  validFrom DateTime @db.DateTime(3)
  validUntil DateTime @db.DateTime(3)
  requestedBy String @db.Char(36)
  reviewedBy String? @db.Char(36)
  state String @default("PENDING") @db.VarChar(20)
  reason String @db.VarChar(500)
  reviewReason String? @db.VarChar(500)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([municipalityId,state])
  @@map("grant_requests")
}
model CouncilTerm {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  municipality Municipality @relation(fields:[municipalityId], references:[id], onDelete:Restrict)
  label String @db.VarChar(80)
  startsOn DateTime @db.Date
  endsOn DateTime @db.Date
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.DateTime(3)
  committees Committee[]
  measures LegislativeMeasure[]
  sessions LegislativeSession[]
  people Person[]
  historicalOrdinances HistoricalOrdinance[]
  @@unique([municipalityId,label])
  @@unique([id,municipalityId])
  @@map("council_terms")
}
model Person {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  municipality Municipality @relation(fields:[municipalityId], references:[id], onDelete:Restrict)
  termId String @db.Char(36)
  term CouncilTerm @relation(fields:[termId,municipalityId], references:[id,municipalityId], onDelete:Restrict)
  displayName String @db.VarChar(160)
  positionCode String @default("OTHER") @db.VarChar(32)
  revision Int @default(1)
  photoMime String? @db.VarChar(40)
  photoSha256 String? @db.Char(64)
  photoBytes Bytes? @db.MediumBlob
  createdAt DateTime @default(now()) @db.DateTime(3)
  members CommitteeMember[]
  attributions MeasureAuthor[]
  sessionAttendance SessionAttendance[]
  @@unique([id,municipalityId])
  @@index([municipalityId,displayName])
  @@index([municipalityId,positionCode])
  @@index([municipalityId,termId])
  @@map("persons")
}
model Committee {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  municipality Municipality @relation(fields:[municipalityId], references:[id], onDelete:Restrict)
  termId String @db.Char(36)
  term CouncilTerm @relation(fields:[termId,municipalityId], references:[id,municipalityId], onDelete:Restrict)
  code String @db.VarChar(30)
  name String @db.VarChar(160)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.DateTime(3)
  members CommitteeMember[]
  referrals CommitteeReferral[]
  meetings CommitteeMeeting[]
  @@unique([municipalityId,termId,code])
  @@unique([id,municipalityId])
  @@map("committees")
}
model CommitteeMember {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  committeeId String @db.Char(36)
  committee Committee @relation(fields:[committeeId,municipalityId], references:[id,municipalityId], onDelete:Restrict)
  personId String @db.Char(36)
  person Person @relation(fields:[personId,municipalityId], references:[id,municipalityId], onDelete:Restrict)
  role String @db.VarChar(20)
  startsOn DateTime @db.Date
  endsOn DateTime @db.Date
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@unique([committeeId,personId,role,startsOn])
  @@index([committeeId,endsOn])
  @@map("committee_members")
}
model AuditCursor {
  municipalityId String @id @db.Char(36)
  municipality Municipality @relation(fields:[municipalityId], references:[id], onDelete:Restrict)
  sequence BigInt @default(0)
  hash String @db.Char(64)
  @@map("audit_cursors")
}
model AuditLog {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  sequence BigInt
  actorId String @db.Char(36)
  actorName String @db.VarChar(160)
  action String @db.VarChar(80)
  entityId String @db.Char(36)
  correlationId String @db.Char(36)
  payload Json
  previousHash String @db.Char(64)
  hash String @db.Char(64)
  recordedAt DateTime @db.DateTime(3)
  @@unique([municipalityId,sequence])
  @@index([municipalityId,recordedAt])
  @@map("audit_logs")
}
model OutboxEvent {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  type String @db.VarChar(80)
  payload Json
  state String @default("PENDING") @db.VarChar(20)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([state,availableAt])
  @@map("outbox_events")
}
model ConsumerReceipt {
  id String @id @db.Char(36)
  consumer String @db.VarChar(80)
  eventId String @db.Char(36)
  completedAt DateTime @default(now()) @db.DateTime(3)
  @@unique([consumer,eventId])
  @@map("consumer_receipts")
}
model IdempotencyRecord {
  id String @id @db.Char(36)
  actorId String @db.Char(36)
  action String @db.VarChar(80)
  key String @db.VarChar(100)
  requestHash String @db.Char(64)
  result Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@unique([actorId,action,key])
  @@map("idempotency_records")
}
model MeasureType {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  municipality Municipality @relation(fields:[municipalityId], references:[id], onDelete:Restrict)
  code String @db.VarChar(20)
  label String @db.VarChar(80)
  retiredAt DateTime? @db.DateTime(3)
  measures LegislativeMeasure[]
  @@unique([municipalityId,code])
  @@map("measure_types")
}
model LegislativeMeasure {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  municipality Municipality @relation(fields:[municipalityId], references:[id], onDelete:Restrict)
  typeId String @db.Char(36)
  type MeasureType @relation(fields:[typeId], references:[id], onDelete:Restrict)
  typeCode String @db.VarChar(20)
  termId String @db.Char(36)
  term CouncilTerm @relation(fields:[termId,municipalityId], references:[id,municipalityId], onDelete:Restrict)
  title String @db.VarChar(240)
  subject String @db.VarChar(500)
  stage String @db.VarChar(20)
  classification String @default("INTERNAL") @db.VarChar(30)
  officialSeries String? @db.VarChar(30)
  officialYear Int?
  officialNumber Int?
  currentVersionId String? @db.Char(36)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  authors MeasureAuthor[]
  versions MeasureVersion[]
  history MeasureStatusHistory[]
  workflow WorkflowInstance?
  documents Document[]
  tasks WorkTask[]
  referrals CommitteeReferral[]
  sessionAgenda SessionAgendaItem[]
  sessionVotes SessionVote[]
  @@unique([id,municipalityId])
  @@unique([municipalityId,officialSeries,officialYear,officialNumber], map:"measures_official_number_key")
  @@index([municipalityId,stage,createdAt])
  @@map("legislative_measures")
}
model MeasureAuthor {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  measureId String @db.Char(36)
  measure LegislativeMeasure @relation(fields:[measureId,municipalityId], references:[id,municipalityId], onDelete:Restrict)
  personId String @db.Char(36)
  person Person @relation(fields:[personId,municipalityId], references:[id,municipalityId], onDelete:Restrict)
  role String @db.VarChar(20)
  ordering Int
  displayName String @db.VarChar(160)
  @@unique([measureId,personId,role])
  @@map("measure_authors")
}
model MeasureVersion {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  measureId String @db.Char(36)
  measure LegislativeMeasure @relation(fields:[measureId,municipalityId], references:[id,municipalityId], onDelete:Restrict)
  sequence Int
  parentVersionId String? @db.Char(36)
  synopsis String @db.VarChar(8000)
  primaryDocumentVersionId String? @db.Char(36)
  frozenAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  referrals CommitteeReferral[]
  @@unique([measureId,sequence])
  @@map("measure_versions")
}
model MeasureStatusHistory {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  measureId String @db.Char(36)
  measure LegislativeMeasure @relation(fields:[measureId,municipalityId], references:[id,municipalityId], onDelete:Restrict)
  sequence Int
  fromStage String? @db.VarChar(20)
  toStage String @db.VarChar(20)
  profileVersionId String @db.Char(36)
  actorId String @db.Char(36)
  reason String @db.VarChar(500)
  recordedAt DateTime @db.DateTime(3)
  @@unique([measureId,sequence])
  @@index([measureId,recordedAt])
  @@map("measure_status_history")
}
model WorkflowProfile {
  id String @id @db.Char(36)
  municipalityId String @db.Char(36)
  municipality Municipality @relation(fields:[municipalityId], references:[id], onDelete:Restrict)
  code String @db.VarChar(40)
  description String @db.VarChar(240)
  versions WorkflowProfileVersion[]
  @@unique([municipalityId,code])
  @@map("workflow_profiles")
}
model WorkflowProfileVersion {
  id String @id @db.Char(36)
  profileId String @db.Char(36)
