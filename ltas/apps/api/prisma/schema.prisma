  @@map("workflow_transitions")
}
model WorkflowInstance {
  id String @id @db.Char(36)
  measureId String @unique @db.Char(36)
  measure LegislativeMeasure @relation(fields:[measureId], references:[id], onDelete:Restrict)
  profileVersionId String @db.Char(36)
