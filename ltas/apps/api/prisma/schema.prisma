model WorkflowTransition {
  id String @id @db.Char(36)
  profileVersionId String @db.Char(36)
  profileVersion WorkflowProfileVersion @relation(fields:[profileVersionId], references:[id], onDelete:Restrict)
  code String @db.VarChar(30)
  fromStage String @db.VarChar(20)
  toStage String @db.VarChar(20)
  permission String @db.VarChar(40)
