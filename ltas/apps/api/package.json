{
 "name": "@ltas/api",
 "version": "0.1.0",
 "private": true,
 "type": "module",
 "scripts": {
  "build": "tsc",
  "typecheck": "tsc --noEmit",
  "dev": "node --watch --env-file=../../.env dist/main.js",
  "start": "node dist/main.js",
  "test": "vitest run",
    "test:mysql": "vitest run src/mysql.access.test.ts src/mysql.measure.test.ts src/mysql.referral.test.ts src/mysql.meeting.test.ts src/mysql.session.test.ts src/mysql.library.test.ts src/mysql.archive.test.ts",
  "db:generate": "prisma generate",
  "db:migrate": "prisma migrate deploy",
  "db:seed": "node --env-file=../../.env dist/seed.js",
  "worker": "node --env-file=../../.env dist/worker.js"
 },
 "dependencies": {
  "@ltas/contracts": "0.1.0",
  "@napi-rs/canvas": "^1.0.9",
  "@nestjs/common": "12.0.4",
  "@nestjs/core": "12.0.4",
  "@nestjs/platform-express": "12.0.4",
  "@prisma/adapter-mariadb": "^7.0.0",
  "@prisma/client": "^7.0.0",
  "connect-redis": "^9.0.0",
  "dotenv": "^17.0.0",
  "express": "^5.1.0",
  "express-session": "^1.18.2",
  "helmet": "^8.1.0",
  "minio": "^8.0.6",
  "openid-client": "^6.8.0",
  "redis": "^5.0.0",
  "reflect-metadata": "^0.2.2",
  "rxjs": "^7.8.2",
  "tesseract.js": "^7.0.0",
  "unpdf": "^1.8.1",
  "zod": "^4.0.0"
 },
 "devDependencies": {
  "@types/express": "^5.0.0",
  "@types/express-session": "^1.18.2",
  "prisma": "^7.0.0"
 }
}
